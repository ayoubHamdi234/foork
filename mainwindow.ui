      <property name="styleSheet">
       <string notr="true">/* --- Conteneur principal du QTabWidget --- */
QTabWidget::pane {
    border: 1px solid #bfc3c7;
    background: rgb(235, 235, 235);
    border-radius: 15px;
    padding: 10px;
    margin-top: 10px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.08);
}

/* --- Barres d’onglets --- */
QTabBar::tab {
    background-color: #f4f4f4;
    color: #333333;
    border: 1px solid #c0c0c0;
    border-radius: 10px;
    min-width: 120px;
    min-height: 35px;
    margin: 4px;
    padding: 6px 14px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.3s ease;
}

/* --- Onglet sélectionné --- */
QTabBar::tab:selected {
    background-color: #d6d6d6;
    color: #000000;
    border: 1px solid #a0a0a0;
    font-weight: bold;
    box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.15);
}

/* --- Onglet au survol --- */
QTabBar::tab:hover {
    background-color: #e0e0e0;
    color: #000000;
}

/* --- Ajustement de la barre d’onglets --- */
QTabWidget::tab-bar {
    alignment: left;
}

/* --- Position des onglets --- */
QTabWidget::tab-bar:top {
    top: 5px;
}

QTabWidget::tab-bar:bottom {
    bottom: 5px;
}

QTabWidget::tab-bar:left {
    left: 5px;
}

QTabWidget::tab-bar:right {
    right: 5px;
}

/* --- Contenu interne des pages --- */
QWidget {
    background-color: rgb(235, 235, 235);
    border-radius: 12px;
    color: #2f2f2f;
}

/* --- Scrollbar verticale --- */
QScrollBar:vertical {
    border: none;
    background: rgb(235, 235, 235);
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #bfbfbf;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #a5a5a5;
}

/* --- Scrollbar horizontale --- */
QScrollBar:horizontal {
    border: none;
    background: rgb(235, 235, 235);
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #bfbfbf;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #a5a5a5;
}
</string>
