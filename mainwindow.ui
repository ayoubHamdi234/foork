        <property name="styleSheet">
         <string notr="true">/* --- Style général du QTableWidget --- */
QTableWidget {
    background-color: rgb(235, 235, 235);
    alternate-background-color: #f3f3f3;
    border: 1px solid #c0c0c0;
    border-radius: 10px;
    gridline-color: #d0d0d0;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    color: #2f2f2f;
    selection-background-color: #d6d6d6;
    selection-color: black;
}

/* --- Lignes alternées --- */
QTableWidget::item:alternate {
    background: #f8f8f8;
}

/* --- Cellules --- */
QTableWidget::item {
    padding: 6px;
    border: none;
}

/* --- Cellule sélectionnée --- */
QTableWidget::item:selected {
    background-color: #d6d6d6;
    color: black;
}

/* --- En-têtes horizontaux (colonnes) --- */
QHeaderView::section {
    background-color: #e0e0e0;
    color: #2f2f2f;
    padding: 6px;
    border: 1px solid #c0c0c0;
    font-weight: bold;
    border-radius: 4px;
}

/* --- En-têtes verticaux (lignes) --- */
QHeaderView::section:vertical {
    background-color: #e0e0e0;
    color: #2f2f2f;
    padding: 4px;
    border: 1px solid #c0c0c0;
    font-weight: normal;
}

/* --- Scrollbars (verticale et horizontale) --- */
QScrollBar:vertical {
    border: none;
    background: rgb(235, 235, 235);
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #bfbfbf;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #a5a5a5;
}

QScrollBar:horizontal {
    border: none;
    background: rgb(235, 235, 235);
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #bfbfbf;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #a5a5a5;
}
</string>
