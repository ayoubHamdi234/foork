        <property name="styleSheet">
         <string notr="true">QFrame#formFrame {
    background-color: #F5F5F5;   /* Fond clair pour contraste */
    border-radius: 25px;          /* Bords arrondis */
    border: 1px solid #CCCCCC;    /* Légère bordure grise */
    padding: 20px;                /* Espacement intérieur */
}

/* Labels du formulaire */
QLabel {
    color: #333333;
    font-size: 16px;
    font-weight: 500;
}

/* Champs de saisie */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 12px;
    padding: 8px 12px;
    font-size: 15px;
    color: #000000;
}

QLineEdit:focus {
    border: 2px solid #4A90E2;   /* Focus bleu pro */
}

/* Boutons du formulaire */
QPushButton {
    background-color: #4A90E2;
    color: #FFFFFF;
    border-radius: 15px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #357ABD;  /* Hover légèrement plus foncé */
}

QPushButton:pressed {
    background-color: #2E5C9A;  /* Effet click */
}</string>
