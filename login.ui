   <property name="styleSheet">
    <string notr="true">/* ================= GLOBAL =================== */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                               stop:0 #f0f4f8, stop:1 #e2e8f0);
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
}

/* ================= TITRES =================== */
QLabel {
    color: #1e293b;
    font-weight: 600;
}

/* Titres principaux */
QLabel#labelLoginTitle,
QLabel#labelQuestionTitle,
QLabel#labelPINTitle,
QLabel#labelNewPassTitle {
    font-size: 28px;
    font-weight: 700;
    color: #1e40af;
    qproperty-alignment: AlignCenter;
    margin-bottom: 10px;
}

/* Question label */
QLabel#labelQuestion {
    font-size: 14px;
    color: #475569;
    background-color: #f1f5f9;
    border-radius: 12px;
    padding: 10px 15px;
    border: 1px solid #cbd5e1;
    min-height: 30px;
    qproperty-alignment: AlignCenter;
}

/* ================= QLineEdit ================ */
QLineEdit {
    background-color: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 15px;
    color: #1e293b;
    selection-background-color: #1e40af;
    selection-color: white;
}

QLineEdit::placeholder {
    color: #94a3b8;
}

QLineEdit:focus {
    border: 2px solid #1e40af;
    background-color: #ffffff;
}

/* PIN ou password spacing */
QLineEdit#lineEditResetPIN,
QLineEdit#lineEditResetNewPass,
QLineEdit#lineEditResetConfirm {
    letter-spacing: 10px;
    font-family: &quot;Courier New&quot;, monospace;
    font-size: 18px;
    font-weight: 600;
}

/* States */
QLineEdit[errorState=&quot;true&quot;] {
    border-color: #ef4444;
    background-color: #fef2f2;
}

QLineEdit[successState=&quot;true&quot;] {
    border-color: #10b981;
    background-color: #f0fdf4;
}

/* ================= QPushButton =============== */
QPushButton {
    background-color: #1e40af;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 14px 28px;
    font-size: 16px;
    font-weight: 600;
    transition: all 0.3s;
}

QPushButton:hover {
    background-color: #1d4ed8;
    cursor: pointer;
}

QPushButton:pressed {
    background-color: #1e3a8a;
}

QPushButton:disabled {
    background-color: #cbd5e1;
    color: #94a3b8;
}

/* Boutons validation verts */
QPushButton#btnValiderQuestion,
QPushButton#btnValiderPIN,
QPushButton#btnResetFinal {
    background-color: #10b981;
}

QPushButton#btnValiderQuestion:hover,
QPushButton#btnValiderPIN:hover,
QPushButton#btnResetFinal:hover {
    background-color: #0f766e;
}

/* Boutons retour lien */
QPushButton#btnBackQuestion,
QPushButton#btnBackPIN,
QPushButton#btnBackNewPass {
    background-color: transparent;
    color: #475569;
    border: none;
    text-decoration: underline;
    font-size: 14px;
    padding: 6px;
}

QPushButton#btnBackQuestion:hover,
QPushButton#btnBackPIN:hover,
QPushButton#btnBackNewPass:hover {
    color: #1e40af;
    text-decoration: none;
}

/* ================= QCheckBox ================= */
QCheckBox {
    color: #475569;
    font-size: 14px;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #cbd5e1;
    border-radius: 6px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #1e40af;
}

QCheckBox::indicator:checked {
    background-color: #1e40af;
    border-color: #1e40af;
    image: url('data:image/svg+xml;utf8,&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;20&quot; height=&quot;20&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;white&quot; stroke-width=&quot;3&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;&gt;&lt;polyline points=&quot;20 6 9 17 4 12&quot;/&gt;&lt;/svg&gt;');
}

/* ================= MESSAGES ================= */
QLabel.error-label {
    color: #b91c1c;
    background-color: #fee2e2;
    border-radius: 10px;
    padding: 10px 15px;
}

QLabel.success-label {
    color: #047857;
    background-color: #d1fae5;
    border-radius: 10px;
    padding: 10px 15px;
}

QLabel.warning-label {
    color: #92400e;
    background-color: #ffedd5;
    border-radius: 10px;
    padding: 10px 15px;
}

/* ================= CARTES &amp; PAGES ================= */
QWidget#page_2,
QWidget#page_3,
QWidget#page_4 {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    margin: 20px;
    padding: 20px;
    box-shadow: 0px 4px 15px rgba(0,0,0,0.05);
}
</string>
